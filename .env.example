# TTS provider switch — "edge" (free, no key, good for iterating on style)
# or "fish" (paid, needs the key below) once we lock a direction.
TTS_PROVIDER=edge

# Fish Audio (https://fish.audio) — only needed when TTS_PROVIDER=fish
FISH_AUDIO_API_KEY=
# Voice "model id" (Fish calls it reference_id). Current pick: the Borat voice.
FISH_AUDIO_DEFAULT_VOICE_ID=403c9c7352a84018b1d1de4b3d33b06f
FISH_BASE_URL=https://api.fish.audio
# TTS backend model. "s2.1-pro-free" = free tier (free through 2026-08-31, fair
# use, requests may be used to improve the model, no SLA). Code default too.
FISH_MODEL=s2.1-pro-free

# Edge TTS (free) — any voice from `npx tsx scripts/list-edge-voices.ts`
EDGE_TTS_VOICE=en-US-AndrewNeural
