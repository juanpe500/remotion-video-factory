node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Whisper.cpp binary + model, downloaded on demand by scripts/generate-captions.ts
whisper.cpp

# Intermediate render frames — scripts/render.ts points TMPDIR here to keep them
# off the container's tiny 64MB /tmp tmpfs.
.rendertmp

# Generated narration audio is regenerable (and provider/voice-dependent) —
# don't commit it. Captions JSON is small and worth keeping for reproducibility.
public/**/audio.mp3
public/**/audio.wav

# BidTier promo — kept local, not published to the repo yet (JP, 2026-08-26).
content/bidtier/
public/bidtier/
src/videos/bidtier/
